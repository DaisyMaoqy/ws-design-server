// ============================================================
// approval-workflow_db —— 审批工作流业务库（独立库）
// 真实域模型（用户角色 / 申请类型 / 步骤 / 申请单详情等）待根据其前端项目反推后补充。
// 此处先用一个占位模型，确保客户端非空、库可创建；后续按需扩展。
// 逻辑外键：以 userId 关联 auth_db，不建 DB 级 FK
// ============================================================

generator client {
  provider = "prisma-client-js"
  output   = "../../src/prisma/generated/approval-workflow"
}

datasource db {
  provider = "mysql"
  url      = env("AWS_DATABASE_URL")
}

// 占位模型（待审批工作流前端域模型反推后替换/扩展）
model AwsProcess {
  id        Int      @id @default(autoincrement())
  code      String   @unique @db.VarChar(64)
  name      String   @db.VarChar(256)
  status    Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
