# 默认环境（本地全模块联调，不指定 ENV_FILE 时使用）
# 三份独立 schema 的连接（本地 mysql 用 localhost 主机；容器内需换成 mysql 服务名，见 docker-compose.yml）
AUTH_DATABASE_URL="mysql://ws_design:ws_design_2026@localhost:3306/auth_db"
WS_DESIGN_DATABASE_URL="mysql://ws_design:ws_design_2026@localhost:3306/ws_design_db"
AWS_DATABASE_URL="mysql://ws_design:ws_design_2026@localhost:3306/approval_workflow_db"

JWT_SECRET="ws-design-jwt-secret-key-2026"
PORT=3000

# 双前端对接：按产品加载模块，留空则加载全部（ws-design,approval-workflow 逗号分隔）
# ENABLE_MODULE=ws-design
# 跨域白名单，逗号分隔；留空则保持原行为（反射任意来源，允许带凭证）
# CORS_ORIGINS=https://a.example.com,https://b.example.com
